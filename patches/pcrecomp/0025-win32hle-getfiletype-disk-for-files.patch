--- a/runtime/win32hle/kernel32_ext.c
+++ b/runtime/win32hle/kernel32_ext.c
@@ -64,6 +64,8 @@
     uint32_t i = h - FH_BASE;
     return (h >= FH_BASE && i < MAXF) ? g_files[i] : NULL;
 }
+/* 1 if h is an open file handle (GetFileType tells files from the console handles). */
+int hle_file_is_open(uint32_t h) { return file_of(h) != NULL; }
 static int file_close(uint32_t h) {
     uint32_t i = h - FH_BASE;
     if (h >= FH_BASE && i < MAXF && g_files[i]) { fclose(g_files[i]); g_files[i] = NULL; return 1; }
--- a/runtime/win32hle/kernel32_crt.c
